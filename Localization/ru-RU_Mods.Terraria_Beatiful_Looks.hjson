Items: {
	StarlightWings: {
		DisplayName: Звёздные крылья
		Tooltip:
			'''
			Позволяют летать и медленно падать
			Оставляют за собой звёздную пыль
			'''
	}

	EmberWings: {
		DisplayName: Пламенные крылья
		Tooltip:
			'''
			Позволяют летать и медленно падать
			Рассыпают искры живого огня
			'''
	}

	FrostWings: {
		DisplayName: Морозные крылья
		Tooltip:
			'''
			Позволяют летать и медленно падать
			С каждым взмахом летят снежинки
			'''
	}

	SakuraWings: {
		DisplayName: Крылья сакуры
		Tooltip:
			'''
			Позволяют летать и медленно падать
			Осыпают лепестками вишни
			'''
	}

	VoidWings: {
		DisplayName: Крылья пустоты
		Tooltip:
			'''
			Позволяют летать и медленно падать
			Сотканы из ночи между звёздами
			'''
	}

	FairyWings: {
		DisplayName: Крылья феи
		Tooltip:
			'''
			Позволяют летать и медленно падать
			Лёгкие, как весенний ветер
			'''
	}

	StarlightCrown: {
		DisplayName: Звёздная корона
		Tooltip: Корона, сияющая как ночное небо
	}

	CatEars: {
		DisplayName: Кошачьи ушки
		Tooltip: Ня~
	}

	DemonHorns: {
		DisplayName: Демонические рожки
		Tooltip: Совсем чуть-чуть злой
	}

	FlowerWreath: {
		DisplayName: Цветочный венок
		Tooltip: Пахнет летним лугом
	}

	FrostTiara: {
		DisplayName: Ледяная тиара
		Tooltip: Никогда не тает
	}

	StarlightCape: {
		DisplayName: Звёздный плащ
		Tooltip: Сшит из ночного неба
	}

	RoyalCape: {
		DisplayName: Королевский плащ
		Tooltip: Достоин короля
	}

	ShadowCape: {
		DisplayName: Теневой плащ
		Tooltip: Загадочно и драматично
	}
}

