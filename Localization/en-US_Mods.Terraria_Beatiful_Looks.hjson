Items: {
	StarlightWings: {
		DisplayName: Starlight Wings
		Tooltip:
			'''
			Allows flight and slow fall
			Sheds glittering stardust
			'''
	}

	EmberWings: {
		DisplayName: Ember Wings
		Tooltip:
			'''
			Allows flight and slow fall
			Trails sparks of living flame
			'''
	}

	FrostWings: {
		DisplayName: Frost Wings
		Tooltip:
			'''
			Allows flight and slow fall
			Snowflakes drift from every flap
			'''
	}

	SakuraWings: {
		DisplayName: Sakura Wings
		Tooltip:
			'''
			Allows flight and slow fall
			Scatters cherry blossom petals
			'''
	}

	VoidWings: {
		DisplayName: Void Wings
		Tooltip:
			'''
			Allows flight and slow fall
			Woven from the night between stars
			'''
	}

	FairyWings: {
		DisplayName: Fairy Wings
		Tooltip:
			'''
			Allows flight and slow fall
			Light as a spring breeze
			'''
	}

	StarlightCrown: {
		DisplayName: Starlight Crown
		Tooltip: A crown that shines like the night sky
	}

	CatEars: {
		DisplayName: Cat Ears
		Tooltip: Nya~
	}

	DemonHorns: {
		DisplayName: Demon Horns
		Tooltip: Just a little bit evil
	}

	FlowerWreath: {
		DisplayName: Flower Wreath
		Tooltip: Smells like a summer meadow
	}

	FrostTiara: {
		DisplayName: Frost Tiara
		Tooltip: Never melts
	}

	StarlightCape: {
		DisplayName: Starlight Cape
		Tooltip: A cape sewn from the night sky
	}

	RoyalCape: {
		DisplayName: Royal Cape
		Tooltip: Fit for a king
	}

	ShadowCape: {
		DisplayName: Shadow Cape
		Tooltip: Mysterious and dramatic
	}
}

Keybinds.ToggleLooksUI.DisplayName: Open Beautiful Looks menu

Configs: {
	LooksClientConfig: {
		DisplayName: Beautiful Looks

		AuraIntensity: {
			Label: Effects intensity
			Tooltip: Global multiplier for all particles and glow from this mod
		}

		MaxParticles: {
			Label: Particle limit
			Tooltip: How many particles from this mod can exist at once. Lower it if the game slows down
		}

		ShaderRibbons: {
			Label: Shader ribbons
			Tooltip: Glowing ribbons on Terraria's own shaders (trails, comet tails). Turn off if something looks wrong
		}

		ShowOtherPlayers: {
			Label: Show other players' looks
			Tooltip: Show auras, trails and effects of other players in multiplayer
		}
	}
}

UI: {
	Title: Beautiful Looks
	DragHint: drag me
	Effects: Effects
	On: on
	Off: off
	Presets: Presets
	Save: Save
	Load: Load
	PresetSaved: Preset {0} saved!
	PresetEmpty: This preset slot is empty
	Random: Random
	Reset: Reset
	TabAura: Aura
	TabTrail: Trail
	TabEffects: Effects
	TabWings: Wings
	WingStyle: Wing style
	Outline: Outline
	WingsHint: Effect wings are drawn over any equipped wings, or even with no wings at all
	WingsHint2: Wings from this mod use these effects on their own, with their own colors
	WingsHint3: A dye in the wings dye slot recolors them too
	TabColors: Colors
	TabLooks: Looks
	TabWardrobe: Wardrobe
	AuraStyle: Aura style
	Density: Density
	Size: Size
	Speed: Speed
	Colors: Colors
	ColorsHint: click to change
